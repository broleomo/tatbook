generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("CLIENT")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  artistProfile    ArtistProfile?
  bookingsAsClient Booking[]      @relation("ClientBookings")
  accounts         Account[]
  sessions         Session[]
}

model ArtistProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName     String
  bio             String?
  location        String?
  instagramHandle String?
  websiteUrl      String?
  portfolioImages String  @default("[]")

  depositAmount  Float   @default(50)
  depositPercent Float?

  googleCalendarConnected Boolean @default(false)
  googleAccessToken       String?
  googleRefreshToken      String?
  googleTokenExpiry       DateTime?
  calendarId              String?

  allowFlash   Boolean @default(true)
  allowCustom  Boolean @default(true)
  customFields String  @default("[]")

  sizeOptions  SizeOption[]
  flashDesigns FlashDesign[]
  bookings     Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SizeOption {
  id       String @id @default(cuid())
  artistId String
  artist   ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  label  String
  price  Float?
  sortOrder Int @default(0)

  @@index([artistId])
}

model FlashDesign {
  id       String @id @default(cuid())
  artistId String
  artist   ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  name        String
  description String?
  imageUrl    String
  available   Boolean @default(true)
  basePrice   Float?
  maxPrice    Float?
  sizes       String  @default("[]")
  sortOrder   Int     @default(0)

  bookings  Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artistId])
}

model Booking {
  id       String @id @default(cuid())
  artistId String
  artist   ArtistProfile @relation(fields: [artistId], references: [id])

  clientId String?
  client   User?   @relation("ClientBookings", fields: [clientId], references: [id])

  clientName  String
  clientEmail String
  clientPhone String?

  bookingType     String
  flashDesignId   String?
  flashDesign     FlashDesign? @relation(fields: [flashDesignId], references: [id])
  referenceImages String       @default("[]")
  size            String
  bodyPlacement   String
  notes           String?

  appointmentDate DateTime?
  appointmentEnd  DateTime?
  googleEventId   String?

  depositAmount   Float
  depositPaid     Boolean @default(false)
  stripeSessionId String?
  stripePaymentId String?
  totalAmount     Float?

  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artistId])
  @@index([clientId])
  @@index([stripeSessionId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
